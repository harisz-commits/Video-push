# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Anthropic — erzeugt Skript und Szenenliste.
ANTHROPIC_API_KEY=
# Optional: überschreibt das Standardmodell (claude-sonnet-5).
ANTHROPIC_MODEL=

# ElevenLabs — erzeugt MP3 samt Zeichen-Timestamps.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# Optional — nur fuer das Thumbnail-Hintergrundbild
# ---------------------------------------------------------------------------

# Google AI Studio (aistudio.google.com/apikey). Ohne diesen Key funktioniert
# das ganze Studio weiter, nur der Knopf "Bild erzeugen" sagt, dass er fehlt.
# Bildmodelle haben KEINE kostenlose Stufe: rund 3,9 Cent pro Bild, und ein
# Bild entsteht ausschliesslich, wenn jemand den Knopf drueckt.
GEMINI_API_KEY=

# Optional: anderes Bildmodell, falls Google eines umbenennt oder abschaltet.
# Standard ist gemini-2.5-flash-image. Neuere Alternativen mit gleicher
# Schnittstelle: gemini-3.1-flash-lite-image, gemini-3.1-flash-image,
# gemini-3-pro-image (teurer, dafuer besser).
GEMINI_IMAGE_MODEL=

# Kommt automatisch vom verbundenen Vercel Blob Store.
# Lokal: `vercel link && vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Guardrails — jeder Aufruf kostet echtes Geld
# ---------------------------------------------------------------------------

# Passwort vor der gesamten App (HTTP Basic, beliebiger Benutzername).
# Lokal weglassen, in Produktion IMMER setzen.
STUDIO_PASSWORD=

# Harte Tageslimits. 0 deaktiviert die jeweilige Route komplett.
DAILY_SCRIPT_LIMIT=40
DAILY_VOICE_LIMIT=20
DAILY_RENDER_LIMIT=10

# Blobs älter als so viele Tage räumt der nächtliche Cron weg.
BLOB_MAX_AGE_DAYS=30

# Setzt Vercel beim Anlegen des Cron-Jobs automatisch.
CRON_SECRET=

# Effort der Skripterzeugung. low ist Standard, weil die Laufzeit hier die
# bindende Grenze ist. medium oder high liefern bessere Skripte, brauchen aber
# mehr Zeit — und die Route muss innerhalb des Function-Timeouts antworten.
ANTHROPIC_EFFORT=low

# Zugriffsmodus des verbundenen Blob-Stores. Muss zum Store passen.
# "public" (Standard) ist erforderlich, damit Player und Download die
# MP3/MP4 per URL laden koennen. "private" nur, wenn du bewusst darauf
# verzichtest — dann bleiben Vorschau-Ton und Video-Download gesperrt.
BLOB_ACCESS=public
