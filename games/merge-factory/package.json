{
  "name": "merge-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merge Factory: Junkyard Empire — HTML5 merge game for YouTube Playables",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "youtube:validate": "tsx scripts/validate-youtube-build.ts",
    "youtube:scan": "tsx scripts/scan-forbidden-urls.ts",
    "smoke": "node scripts/browser-smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run youtube:validate"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "playwright": "^1.62.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
