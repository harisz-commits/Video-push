{
	"compilerOptions": {
		"target": "es2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		// create-snapshot.ts runs under node --experimental-strip-types, where ESM
		// requires the explicit .ts specifier on relative imports.
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noUnusedLocals": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"incremental": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	// games/ holds standalone sub-projects with their own tsconfig, dependencies
	// and build. They must not be pulled into this project's typecheck.
	"exclude": ["node_modules", "remotion.config.ts", "games"]
}
